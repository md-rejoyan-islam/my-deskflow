<?xml version='1.0' encoding='windows-1252'?>
<!--
  InputSync Windows MSI definition (WiX 3), used by cargo-wix.

  cargo-wix looks for this file at `wix/main.wxs` relative to the package's
  Cargo.toml (i.e. crates/daemon/wix/main.wxs). It injects these WiX
  variables at candle/light time:
    $(var.CargoTargetBinDir) -> the binary output dir (target/release)
    $(var.Version)           -> the crate version from Cargo.toml

  Invoked in the release workflow as:
    cargo wix -no-build -p inputsync-daemon
  (the binaries are already built by the earlier cargo build -release).

  Installs all three binaries (daemon, cli, gui) to Program Files\InputSync,
  adds a Start Menu shortcut for the GUI, and opens the inbound firewall
  rule for port 24800 (server mode) at install time.
-->
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
  <Product
    Id='*'
    Name='InputSync'
    UpgradeCode='8a5c2f9e-1234-4d3b-9c1a-2a7e0f5b1d04'
    Manufacturer='InputSync Contributors'
    Language='1033'
    Codepage='1252'
    Version='$(var.Version)'>

    <Package Id='*' Keywords='Installer' Description='InputSync $(var.Version) installer'
      Manufacturer='InputSync Contributors' InstallerVersion='450' Languages='1033'
      Compressed='yes' InstallScope='perMachine' />

    <MajorUpgrade Schedule='afterInstallInitialize' DowngradeErrorMessage='A newer version of InputSync is already installed.' />
    <Media Id='1' Cabinet='InputSync.cab' EmbedCab='yes' />

    <!-- Properties for Add/Remove Programs entry -->
    <Property Id='ARPCOMMENTS' Value='Cross-machine keyboard, mouse, clipboard and file sharing' />
    <Property Id='ARPURLINFOABOUT' Value='https://github.com/inputsync/inputsync' />

    <!-- Target directory layout -->
    <Directory Id='TARGETDIR' Name='SourceDir'>
      <Directory Id='ProgramFiles64Folder' Name='PFiles'>
        <Directory Id='INSTALLDIR' Name='InputSync'>
        </Directory>
      </Directory>

      <!-- Start Menu shortcuts -->
      <Directory Id='ProgramMenuFolder' Name='Programs'>
        <Directory Id='ApplicationProgramsFolder' Name='InputSync'/>
      </Directory>
    </Directory>

    <!-- Files: all three binaries into Program Files\InputSync.
         cargo-wix substitutes $(var.CargoTargetBinDir) with target/release. -->
    <DirectoryRef Id='INSTALLDIR'>
      <Component Id='DaemonBinary' Guid='*' Win64='yes'>
        <File Id='DaemonExe' Name='inputsync-daemon.exe' DiskId='1' Source='$(var.CargoTargetBinDir)\inputsync-daemon.exe' KeyPath='yes'/>
      </Component>
      <Component Id='CliBinary' Guid='*' Win64='yes'>
        <File Id='CliExe' Name='inputsync-cli.exe' DiskId='1' Source='$(var.CargoTargetBinDir)\inputsync-cli.exe' KeyPath='yes'/>
      </Component>
      <Component Id='GuiBinary' Guid='*' Win64='yes'>
        <File Id='GuiExe' Name='inputsync-gui.exe' DiskId='1' Source='$(var.CargoTargetBinDir)\inputsync-gui.exe' KeyPath='yes'/>
      </Component>
    </DirectoryRef>

    <!-- Start Menu shortcut to the GUI -->
    <DirectoryRef Id='ApplicationProgramsFolder'>
      <Component Id='GuiShortcut' Guid='*' Win64='yes'>
        <Shortcut Id='GuiStartMenuShortcut'
          Name='InputSync'
          Target='[INSTALLDIR]inputsync-gui.exe'
          WorkingDirectory='INSTALLDIR'
          Advertise='no' />
        <RemoveFolder Id='ApplicationProgramsFolder' On='uninstall'/>
        <RegistryValue Root='HKCU' Key='Software\InputSync' Name='installed' Type='integer' Value='1' KeyPath='yes'/>
      </Component>
    </DirectoryRef>

    <!-- Feature tree -->
    <Feature Id='Complete' Title='InputSync' Level='1' Description='Complete package.'
      Display='expand' ConfigurableDirectory='INSTALLDIR'>
      <Feature Id='Binaries' Title='Binaries' Level='1' Description='Application binaries.'>
        <ComponentRef Id='DaemonBinary'/>
        <ComponentRef Id='CliBinary'/>
        <ComponentRef Id='GuiBinary'/>
      </Feature>
      <Feature Id='Shortcuts' Title='Start Menu shortcut' Level='1' Description='Add a Start Menu shortcut for the GUI.'>
        <ComponentRef Id='GuiShortcut'/>
      </Feature>
    </Feature>

    <UI>
      <UIRef Id='WixUI_InstallDir'/>
      <Property Id='WIXUI_INSTALLDIR' Value='INSTALLDIR'/>
    </UI>

    <!--
      Firewall rule for the listen port (server mode). Added at install time
      (the MSI runs elevated, so this satisfies the "admin at install only"
      UX — no UAC prompt every launch). Removed on uninstall. Port 24800,
      inbound TCP + UDP (the desktop-share transport listens here).
    -->
    <CustomAction Id='AddFirewallRuleTcp'
      Directory='INSTALLDIR'
      Execute='deferred'
      Impersonate='no'
      ExeCommand='[SystemFolder]netsh.exe advfirewall firewall add rule name="InputSync" dir=in action=allow protocol=TCP localport=24800'
      Return='ignore' />
    <CustomAction Id='AddFirewallRuleUdp'
      Directory='INSTALLDIR'
      Execute='deferred'
      Impersonate='no'
      ExeCommand='[SystemFolder]netsh.exe advfirewall firewall add rule name="InputSync-UDP" dir=in action=allow protocol=UDP localport=24800'
      Return='ignore' />
    <CustomAction Id='RemoveFirewallRuleTcp'
      Directory='INSTALLDIR'
      Execute='deferred'
      Impersonate='no'
      ExeCommand='[SystemFolder]netsh.exe advfirewall firewall delete rule name="InputSync"'
      Return='ignore' />
    <CustomAction Id='RemoveFirewallRuleUdp'
      Directory='INSTALLDIR'
      Execute='deferred'
      Impersonate='no'
      ExeCommand='[SystemFolder]netsh.exe advfirewall firewall delete rule name="InputSync-UDP"'
      Return='ignore' />

    <InstallExecuteSequence>
      <Custom Action='AddFirewallRuleTcp' After='InstallFiles'>NOT Installed</Custom>
      <Custom Action='AddFirewallRuleUdp' After='AddFirewallRuleTcp'>NOT Installed</Custom>
      <Custom Action='RemoveFirewallRuleTcp' After='RemoveFiles'>REMOVE~="ALL"</Custom>
      <Custom Action='RemoveFirewallRuleUdp' After='RemoveFirewallRuleTcp'>REMOVE~="ALL"</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
